.venv/
__pycache__/
.env
data/raw/
data/clean/
data/snapshots/
# data/lines/ is kept: it is our only record of line history
board/preview.html
# live engine demo replays are throwaway; real engine logs (data/live/<game>/) are kept
# status.json is the engine's 20-second heartbeat, read by the board build
data/live/status.json
data/live/demo_ledger/
data/live/*_demo/

# SportsGameOdds raw events (large); tidy tables in data/sgo/*.parquet are kept
data/sgo/raw/
data/sgo/raw_alt/

# GitHub Pages output (built by the workflow)
site/

# ---- kept off the public repo (third-party odds data; lives on the laptop and in the Actions cache)
data/oddspapi/*
!data/oddspapi/fixtures_t31.json
!data/oddspapi/markets_s14.json
!data/oddspapi/players_s14.json
data/propline/
data/sgo/
data/live/
reports/*.parquet
!reports/projections.parquet
!reports/parlay_rules.parquet
!reports/bets.parquet
!reports/live_replay_flags.parquet
!reports/live_windows_flags.parquet
reports/*.log
.claude/

# NBA (nba/): hoopR downloads and ESPN box scores are fetched again whenever missing; odds data stays off the
# public repo. All three live in the NBA workflow's Actions cache. The OddsPapi fixture, market and player lists
# are reference data, kept like the NFL's.
data/nba/raw/
data/nba/odds/
data/nba/box/
!data/oddspapi/fixtures_t132.json
!data/oddspapi/markets_s11.json
!data/oddspapi/players_s11.json
!data/oddspapi/tournaments_s11.json

# The page is rendered from board/nfl_data.json and board/nba_data.json (board/render.py) wherever it is
# published, so the two sports' builds never collide on it
board/nfl_board.html
